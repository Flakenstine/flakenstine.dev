---
interface Props {
  text: string;
  typingSpeed?: number;
  initialDelay?: number;
  showCursor?: boolean;
  cursorCharacter?: string;
  class?: string;
}

const {
  text,
  typingSpeed = 75,
  initialDelay = 1000,
  showCursor = true,
  cursorCharacter = "_",
  class: className,
} = Astro.props;
---

{/* The full text lives in aria-label so screen readers get it at once. */}
<span
  class:list={["text-type", className]}
  data-text={text}
  data-speed={typingSpeed}
  data-delay={initialDelay}
  aria-label={text}
>
  <span class="text-type-content" aria-hidden="true"></span>
  {
    showCursor && (
      <span class="text-type-cursor" aria-hidden="true">
        {cursorCharacter}
      </span>
    )
  }
</span>

<style>
  .text-type-cursor {
    display: inline-block;
    animation: text-type-blink 0.5s ease-in-out infinite alternate;
  }

  @keyframes text-type-blink {
    to {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .text-type-cursor {
      animation: none;
    }
  }
</style>

<script>
  const run = () => {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    document.querySelectorAll<HTMLElement>(".text-type").forEach((el) => {
      const target = el.querySelector<HTMLElement>(".text-type-content");
      if (!target) return;

      const text = el.dataset.text ?? "";
      const speed = Number(el.dataset.speed ?? 75);
      const delay = Number(el.dataset.delay ?? 0);

      // Anyone who asked for less motion just gets the finished line.
      if (reduced) {
        target.textContent = text;
        return;
      }

      target.textContent = "";
      let i = 0;
      let timer: number;

      const tick = () => {
        target.textContent = text.slice(0, ++i);
        if (i < text.length) timer = window.setTimeout(tick, speed);
      };

      timer = window.setTimeout(tick, delay);
      // Stop typing into a node the view transition is about to discard.
      document.addEventListener("astro:before-swap", () => clearTimeout(timer), {
        once: true,
      });
    });
  };

  run();
  document.addEventListener("astro:page-load", run);
</script>
