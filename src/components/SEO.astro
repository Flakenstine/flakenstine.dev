---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import defaultOg from "@/assets/flak-logo.png";

interface Props {
  title: string;
  /** Bare title for social cards / structured data (no site-name prefix). */
  headline?: string;
  description: string;
  image?: ImageMetadata;
  /** Set for blog posts so search engines get article metadata. */
  article?: {
    publishedTime: Date;
    author: string;
    tags: string[];
  };
}

const { title, headline = title, description, image, article } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
// Cap at the source width: upscaling a small source just inflates the file.
const ogSource = image ?? defaultOg;
const og = await getImage({
  src: ogSource,
  width: Math.min(1200, ogSource.width),
  format: "png",
});
const ogUrl = new URL(og.src, Astro.site);

const schema = article
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline,
      description,
      image: ogUrl.href,
      datePublished: article.publishedTime.toISOString(),
      keywords: article.tags.join(", "),
      author: { "@type": "Person", name: article.author, url: Astro.site?.href },
      mainEntityOfPage: { "@type": "WebPage", "@id": canonical.href },
    }
  : {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "flakenstine.dev",
      description,
      url: Astro.site?.href,
      author: { "@type": "Person", name: "Isaac Goodwin", alternateName: "Flakenstine" },
    };
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<meta property="og:type" content={article ? "article" : "website"} />
<meta property="og:title" content={headline} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:site_name" content="flakenstine.dev" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@Flakenstine" />
<meta name="twitter:creator" content="@Flakenstine" />
<meta name="twitter:title" content={headline} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />

{
  article && (
    <>
      <meta
        property="article:published_time"
        content={article.publishedTime.toISOString()}
      />
      <meta property="article:author" content={article.author} />
      {article.tags.map((tag) => (
        <meta property="article:tag" content={tag} />
      ))}
    </>
  )
}

<meta name="theme-color" content="#00FF9D" />
<link rel="alternate" type="application/rss+xml" title="flakenstine.dev" href={new URL("rss.xml", Astro.site)} />

<script
  type="application/ld+json"
  set:html={JSON.stringify(schema)}
  is:inline
/>
