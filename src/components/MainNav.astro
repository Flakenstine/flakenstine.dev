---
import { DiscordPresence } from "@/components/discord-presence";

const navItems = [
  { name: "Home", href: "/" },
  { name: "Blog", href: "/blog" },
];
---

<div class="hidden items-center gap-8 font-mono md:flex">
  {
    navItems.map((item) => (
      <a
        class="nav-link rounded-md px-2 py-1.5 font-bold uppercase tracking-wide transition-all duration-200 hover:bg-[#00FF9D] hover:text-black"
        href={item.href}
        data-nav-href={item.href}
      >
        {item.name}
      </a>
    ))
  }
  <DiscordPresence
    client:idle
    userId="129471053717176320"
    href="https://discordapp.com/users/129471053717176320"
    handle="@flakenstine"
  />
</div>

<style>
  .nav-link[aria-current="page"] {
    color: #00ff9d;
  }
  .nav-link[aria-current="page"]:hover {
    color: #000;
  }
</style>

<script>
  // The header is transition:persist'd, so the active link has to be
  // recomputed on each client-side navigation rather than at render time.
  const setActive = () => {
    const path = window.location.pathname;
    document.querySelectorAll<HTMLAnchorElement>("[data-nav-href]").forEach((link) => {
      const href = link.dataset.navHref!;
      const active = href === "/" ? path === "/" : path.startsWith(href);
      if (active) link.setAttribute("aria-current", "page");
      else link.removeAttribute("aria-current");
    });
  };

  setActive();
  document.addEventListener("astro:page-load", setActive);
</script>
