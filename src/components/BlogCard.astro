---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  slug: string;
  date: string;
  tags?: string[];
}

const { title, description, image, slug, date, tags = [] } = Astro.props;
---

<article class="blog-card rounded-lg bg-transparent p-4 shadow-md">
  <a href={`/blog/${slug}`} class="block focus:outline-none">
    <div
      class="rounded-[24px] border border-white/10 bg-neutral-900/40 p-2 shadow-[0_1px_1px_rgba(0,0,0,0.05),0_4px_6px_rgba(34,42,53,0.04),0_24px_68px_rgba(47,48,55,0.05)]"
    >
      <div
        class="relative mb-6 h-[190px] w-full overflow-hidden rounded-[20px] bg-black/40"
      >
        {
          image && (
            <Image
              src={image}
              alt={title}
              width={600}
              height={380}
              class="h-full w-full rounded-[16px] object-cover"
              loading="lazy"
            />
          )
        }
      </div>
      <h2 class="mt-2 px-1 text-lg font-semibold leading-tight">{title}</h2>
      <p class="px-1 pb-2 text-sm text-neutral-400">{description}</p>
      <div class="flex flex-wrap items-center gap-2 px-1 pb-2">
        {
          tags.map((tag) => (
            <span class="rounded-full border border-[#00FF9D]/30 px-2 py-0.5 font-mono text-xs text-[#00FF9D]">
              {tag}
            </span>
          ))
        }
      </div>
      <div class="flex items-center px-1 pb-2">
        <p class="text-sm text-gray-400">Published on {date}</p>
      </div>
    </div>
  </a>
</article>

<style>
  .blog-card {
    transition: transform 200ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .blog-card:hover,
  .blog-card:focus-within {
    transform: scale(1.05) rotate(-1deg);
  }
  .blog-card:active {
    transform: scale(0.95) rotate(-1deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .blog-card,
    .blog-card:hover,
    .blog-card:focus-within,
    .blog-card:active {
      transform: none;
      transition: none;
    }
  }
</style>
