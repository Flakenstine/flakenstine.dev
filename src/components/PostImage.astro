---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata | string;
  alt?: string;
}

const { src, alt = "" } = Astro.props;
---

{
  typeof src === "string" ? (
    <img src={src} alt={alt} loading="lazy" decoding="async" />
  ) : (
    <Image
      src={src}
      alt={alt}
      widths={[480, 768, 1024]}
      sizes="(max-width: 768px) 100vw, 768px"
      loading="lazy"
    />
  )
}
