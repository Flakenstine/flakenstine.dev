---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import BlogCard from "@/components/BlogCard.astro";
import { formatPostDate } from "@/lib/posts";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

<BaseLayout
  title="flakenstine.dev | Blog"
  description="Welcome to my blog! Here you can find my latest thoughts and ideas."
>
  <main class="container mx-auto px-4 py-16">
    <h1 class="mb-4 text-center text-3xl font-bold">flakenstine.dev | Blog</h1>
    <p class="mb-8 text-center font-mono text-sm text-gray-400">
      {posts.length}
      {posts.length === 1 ? "post" : "posts"} ·{" "}
      <a href="/rss.xml" class="text-[#00FF9D] hover:underline">RSS</a>
    </p>

    {
      tags.length > 0 && (
        <div class="mb-10 flex flex-wrap items-center justify-center gap-2">
          {tags.map((tag) => (
            <a
              href={`/blog/tags/${tag}`}
              class="rounded-full border border-[#00FF9D]/30 px-3 py-1 font-mono text-xs text-[#00FF9D] transition-colors hover:bg-[#00FF9D] hover:text-black"
            >
              #{tag}
            </a>
          ))}
        </div>
      )
    }

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        posts.length > 0 ? (
          posts.map((post) => (
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              image={post.data.image}
              slug={post.id}
              date={formatPostDate(post.data.date)}
              tags={post.data.tags}
            />
          ))
        ) : (
          <div class="col-span-1 rounded-lg border border-white/10 p-8 text-center sm:col-span-2 lg:col-span-3">
            <h2 class="text-lg font-semibold">No Blog Posts Available</h2>
            <p class="mt-2 text-sm text-gray-400">
              It seems there are no blog posts at the moment. Please check back
              later!
            </p>
          </div>
        )
      }
    </div>
  </main>
</BaseLayout>
