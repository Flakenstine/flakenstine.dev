---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BlogCard from "@/components/BlogCard.astro";
import { MoveLeft } from "lucide-react";
import { getSortedPosts, formatPostDate } from "@/lib/posts";
import type { Post } from "@/lib/posts";

export async function getStaticPaths() {
  const posts = await getSortedPosts();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];

  return tags.map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}

interface Props {
  tag: string;
  posts: Post[];
}

const { tag, posts } = Astro.props;
---

<BaseLayout
  title={`flakenstine.dev | #${tag}`}
  description={`Posts tagged ${tag} on flakenstine.dev`}
>
  <main class="container mx-auto px-4 py-16">
    <a
      href="/blog"
      class="mb-8 inline-flex items-center gap-2 text-[#00FF9D] hover:underline"
    >
      <MoveLeft className="h-4 w-4" />
      All posts
    </a>
    <h1 class="mb-2 text-center text-3xl font-bold">
      <span class="text-[#00FF9D]">#</span>{tag}
    </h1>
    <p class="mb-10 text-center font-mono text-sm text-gray-400">
      {posts.length}
      {posts.length === 1 ? "post" : "posts"}
    </p>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        posts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            image={post.data.image}
            slug={post.id}
            date={formatPostDate(post.data.date)}
            tags={post.data.tags}
          />
        ))
      }
    </div>
  </main>
</BaseLayout>
