---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="flakenstine.dev | 404"
  description="This page wandered off into the digital landscape."
>
  <main
    class="container mx-auto flex min-h-[60vh] flex-col items-center justify-center gap-6 px-4 py-16 text-center"
  >
    <p class="font-mono text-7xl font-bold text-[#00FF9D] md:text-9xl">404</p>
    <h1 class="text-2xl font-bold md:text-4xl">
      This page wandered off.
    </h1>
    <p class="max-w-md font-mono text-gray-400">
      Either it never existed, or it is off roaming Azeroth somewhere. Let&apos;s
      get you back on the map.
    </p>
    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="/"
        class="rounded-md bg-[#00FF9D] px-4 py-2 font-mono text-sm font-bold uppercase tracking-wide text-black transition-colors hover:bg-[#00FF9D]/90"
      >
        Go home
      </a>
      <a
        href="/blog"
        class="rounded-md border border-[#00FF9D]/40 px-4 py-2 font-mono text-sm font-bold uppercase tracking-wide text-[#00FF9D] transition-colors hover:bg-[#00FF9D] hover:text-black"
      >
        Read the blog
      </a>
    </div>
  </main>
</BaseLayout>
