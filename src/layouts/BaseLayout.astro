---
import "@/styles/global.css";
import "@fontsource-variable/figtree";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/700.css";
import { ClientRouter, slide } from "astro:transitions";
import type { ImageMetadata } from "astro";
import SEO from "@/components/SEO.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { Toaster } from "@/components/ui/sonner";

interface Props {
  title?: string;
  headline?: string;
  description?: string;
  image?: ImageMetadata;
  article?: {
    publishedTime: Date;
    author: string;
    tags: string[];
  };
}

const {
  title = "flakenstine.dev | website guy",
  headline,
  description = "I like to make cool websites",
  image,
  article,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <SEO
      title={title}
      headline={headline}
      description={description}
      image={image}
      article={article}
    />
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-black font-sans text-white">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-[#00FF9D] focus:px-4 focus:py-2 focus:font-mono focus:text-black"
    >
      Skip to content
    </a>
    <SiteHeader transition:persist />
    <div id="main" transition:animate={slide({ duration: "0.4s" })}>
      <slot />
    </div>
    <SiteFooter transition:persist />
    <Toaster
      client:idle
      transition:persist
      position="bottom-right"
      toastOptions={{
        style: {
          background: "#000",
          border: "1px solid #00FF9D",
          color: "#fff",
        },
      }}
    />
  </body>
</html>
